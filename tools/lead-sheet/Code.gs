/**
 * Evolution24 Properties: the leasing team's lead sheet, in Google Sheets.
 *
 * Built on the Charlotte Square lead sheet, with one tab per property.
 * Enquiries from the evolution24.net contact form arrive on the tab for the
 * property they are about, newest at the top, or on General when the visitor
 * did not pick one. Charlotte Square is not here: it has its own site, form
 * and lead sheet.
 *
 * Every row has a Status dropdown, an Owner dropdown, a Next step date, a
 * Replied checkbox and a Notes column. A new lead nobody has replied to after
 * a day turns pale red; a Next step date that has come round turns red. The
 * Overview tab adds every tab up, under the Evolution24 logo, and lists each
 * property with what is waiting on it. The dropdown choices live on the Lists
 * tab, so the team can change them without touching this code.
 *
 * The website sends each enquiry to this script's web-app address with a
 * secret token. Nothing without the token can add a row, and the web app can
 * only add rows: it cannot read, change or delete anything.
 *
 * ONE-TIME SETUP (about five minutes)
 *   1. Signed in with your Evolution24 Google Workspace account, make a new
 *      Google Sheet (sheets.new) and name it, e.g. "Evolution24 leads".
 *      Whoever makes it owns it; the script runs as them.
 *   2. Extensions → Apps Script. Delete the sample code, paste this whole file
 *      in, and press Save.
 *   3. In the toolbar, check the function menu says "setup" and press Run.
 *      Allow access when Google asks (if it says the app isn't verified:
 *      Advanced → Go to the project). The sheet gets its tabs, dropdowns and
 *      colours. The connection token appears in the Execution log.
 *   4. Deploy → New deployment → gear icon → Web app.
 *      Execute as: Me. Who has access: Anyone. Press Deploy and copy the
 *      Web app URL. ("Anyone" lets the website reach it; the token keeps
 *      everyone else out. Who can SEE the sheet is its Share setting.)
 *   5. In Vercel, on the evolution24-net project, Settings → Environment
 *      Variables, add LEADS_SHEET_URL (the Web app URL) and LEADS_SHEET_TOKEN
 *      (the token from step 3), then redeploy.
 *   6. Share the sheet (Share button) with the leasing team as Editors.
 *      Keep it inside the Workspace: it holds prospects' contact details.
 *
 * UPDATING THIS CODE LATER: paste over the old code, Save, Run setup (it
 * restyles and never deletes a lead), then Deploy → Manage deployments →
 * pencil → Version: New version → Deploy. The web-app address stays the same.
 *
 * Lost the token? Open the sheet: Evolution24 menu → Show the connection token.
 */

const OVERVIEW = 'Overview';
const GENERAL = 'General';   // enquiries with no property picked
const LISTS = 'Lists';
const ROWS = 400;            // rows made ready on each tab; new leads push them down
const ROW_H = 44;            // every lead row: two lines of a message, then clipped

const HEADERS = ['Received', 'Status', 'Owner', 'Next step', 'Replied', 'Name', 'Email', 'Phone',
  'Interested in', 'Bedrooms', 'Moving in', 'Heard about us', 'Came via', 'Message', 'Notes', 'Enquiry #'];
const WIDTHS = [150, 128, 110, 110, 76, 170, 220, 130, 170, 110, 150, 160, 200, 380, 280, 132];
const COL = {};
HEADERS.forEach((h, i) => { COL[h] = i + 1; });

// The website's own colours and type.
const INK = '#151613';
const CREAM = '#E5E6D3';
const TAN = '#DEBB92';
const PAGE = '#F4F1EA';
const ELEV = '#FBF9F5';
const LINE = '#E4DED2';
const MUTED = '#8C8A80';
const SUBTLE = '#5C5D55';
const ACCENT = '#8A6232';
const URGENT = '#B42318';
const URGENT_BG = '#FBEDEA';
const SERIF = 'Instrument Serif';
const SANS = 'Manrope';

// Status: the choice, its chip colour and its text colour.
const STATUS = [
  ['New', '#F3E6D3', '#8A6232'],
  ['Contacted', '#F7EBD0', '#7D6220'],
  ['Tour booked', '#DCE7F1', '#294B6B'],
  ['Toured', '#E5E0EF', '#4A3D6B'],
  ['Applied', '#DFEBE4', '#2E473F'],
  ['Leased', '#2E473F', '#FFFFFF'],
  ['Not a fit', '#ECE8E2', '#6B6660'],
  ['No reply', '#ECE8E2', '#6B6660'],
];
const CLOSED = ['Leased', 'Not a fit', 'No reply'];
const OWNERS = ['Tesa', 'Tatum', 'Unassigned'];
// Tab colours by region, so the strip of tabs reads by city.
const REGION_COLOURS = { rochester: '#8A6232', syracuse: '#3F6F47', geneva: '#294B6B' };

/* GENERATED by scripts/build.py from the website's property list. Edit data/properties.json, not this block. */
const PROPERTIES = [
  { name: "301 Central Avenue", city: "Rochester", region: "rochester" },
  { name: "145 South Fitzhugh", city: "Rochester", region: "rochester" },
  { name: "Water Street", city: "Rochester", region: "rochester" },
  { name: "The Biltmore", city: "Rochester", region: "rochester" },
  { name: "181 St. Paul", city: "Rochester", region: "rochester" },
  { name: "2215 James Street", city: "Syracuse", region: "syracuse" },
  { name: "121 Park Drive", city: "Manlius", region: "syracuse" },
  { name: "379 South Main", city: "Geneva", region: "geneva" },
  { name: "561 South Main", city: "Geneva", region: "geneva" },
  { name: "31 Genesee Street", city: "Geneva", region: "geneva" },
];
const SOURCES = ["Search", "Apartment listing site", "Social media", "Drove or walked by", "Friend or resident"];
/* END GENERATED */

/** Run this one. (It is first so the editor's Run menu picks it.)
 *  Builds and styles the Overview, General, one tab per property, and Lists.
 *  Safe to run again: it restyles, and never deletes a lead. */
function setup() {
  const ss = SpreadsheetApp.getActive();
  let overview = ss.getSheetByName(OVERVIEW);
  if (!overview) {
    const first = ss.getSheets()[0];
    overview = ss.getSheets().length === 1 && first.getLastRow() === 0 ? first.setName(OVERVIEW) : ss.insertSheet(OVERVIEW);
  }
  const lists = ss.getSheetByName(LISTS) || ss.insertSheet(LISTS);
  buildLists_(lists);

  const tabs = leadTabs_();
  tabs.forEach((name) => buildLeads_(ss.getSheetByName(name) || ss.insertSheet(name), lists, colourFor_(name)));
  buildOverview_(overview);

  // Overview, General, the properties in the website's order, then Lists.
  [OVERVIEW].concat(tabs, [LISTS]).forEach((name, i) => {
    ss.setActiveSheet(ss.getSheetByName(name));
    ss.moveActiveSheet(i + 1);
  });
  ss.setActiveSheet(overview);

  const token = tokenFor_();
  console.log('Connection token. Paste the next line, and only that, into Vercel as LEADS_SHEET_TOKEN:');
  console.log(token);
  ss.toast('Done. The connection token is in the Apps Script execution log, or use Evolution24 → Show the connection token.', 'Lead sheet ready', 15);
}

/** The lead tabs: General, every property, and any tab the website has
 *  added since for a property this code did not know yet. */
function leadTabs_() {
  const extra = JSON.parse(PropertiesService.getScriptProperties().getProperty('EXTRA_TABS') || '[]');
  const known = [GENERAL].concat(PROPERTIES.map((p) => p.name));
  return known.concat(extra.filter((n) => known.indexOf(n) < 0));
}

function colourFor_(name) {
  if (name === GENERAL) return INK;
  const p = PROPERTIES.filter((x) => x.name === name)[0];
  return (p && REGION_COLOURS[p.region]) || ACCENT;
}

/* ---- Lists: the dropdown choices, the team's to edit ---------------------- */
function buildLists_(lists) {
  if (lists.getLastRow() === 0) {
    lists.getRange(2, 1, STATUS.length, 1).setValues(STATUS.map((s) => [s[0]]));
    lists.getRange(2, 2, OWNERS.length, 1).setValues(OWNERS.map((o) => [o]));
  }
  lists.getRange(1, 1, 1, 2).setValues([['Status', 'Owner']]);
  lists.getRange(1, 3).setValue('Edit these lists and the dropdowns on every tab follow. One choice per cell.');
  lists.getRange(1, 1, lists.getMaxRows(), 3).setFontFamily(SANS).setFontSize(10).setVerticalAlignment('middle');
  lists.getRange(1, 1, 1, 2).setBackground(INK).setFontColor(CREAM).setFontWeight('bold');
  lists.getRange(1, 3).setFontColor(MUTED).setFontStyle('italic');
  lists.setRowHeight(1, 36);
  lists.setColumnWidths(1, 2, 190);
  lists.setColumnWidth(3, 480);
  lists.setFrozenRows(1);
  lists.setTabColor(MUTED);
  lists.setConditionalFormatRules(statusRules_(lists.getRange(1, 1, lists.getMaxRows(), 1)));
}

/* ---- A lead tab: one row per enquiry -------------------------------------- */
function buildLeads_(leads, lists, colour) {
  if (leads.getMaxRows() < ROWS) leads.insertRowsAfter(leads.getMaxRows(), ROWS - leads.getMaxRows());
  if (leads.getMaxColumns() < HEADERS.length) {
    leads.insertColumnsAfter(leads.getMaxColumns(), HEADERS.length - leads.getMaxColumns());
  }
  const last = leads.getMaxRows();
  const width = HEADERS.length;

  // Column titles: ink, like the website's footer, with a note on the ones to use.
  const head = leads.getRange(1, 1, 1, width);
  head.setValues([HEADERS]).setBackground(INK).setFontColor(CREAM).setFontFamily(SANS).setFontSize(10)
    .setFontWeight('bold').setVerticalAlignment('middle').setHorizontalAlignment('left');
  leads.setRowHeight(1, 40);
  leads.setFrozenRows(1);
  leads.setFrozenColumns(0);
  WIDTHS.forEach((w, i) => leads.setColumnWidth(i + 1, w));
  const notes = {
    'Status': 'Where this lead stands. The choices are on the Lists tab.',
    'Owner': 'Who is looking after it.',
    'Next step': 'When to follow up. Double-click for a calendar. Turns red on the day.',
    'Replied': 'Tick once someone has replied. A New lead with no reply after a day turns the row pale red.',
    'Came via': 'The site or ad link that brought them, when the website could tell.',
    'Notes': 'Anything the team should know.',
    'Enquiry #': 'The same reference as in the email the team received.',
  };
  HEADERS.forEach((h, i) => leads.getRange(1, i + 1).setNote(notes[h] || ''));

  // The body: the website's type, calm rows, room to read.
  const body = leads.getRange(2, 1, last - 1, width);
  body.setFontFamily(SANS).setFontSize(10).setFontColor(INK).setVerticalAlignment('middle')
    .setWrapStrategy(SpreadsheetApp.WrapStrategy.CLIP);
  leads.setRowHeightsForced(2, last - 1, ROW_H);
  const col = (name) => leads.getRange(2, COL[name], last - 1, 1);
  col('Received').setNumberFormat('mmm d, h:mm am/pm').setFontColor(SUBTLE);
  col('Name').setFontWeight('bold');
  col('Email').setFontColor(ACCENT);
  ['Name', 'Email', 'Phone', 'Came via', 'Message', 'Notes', 'Enquiry #'].forEach((h) => col(h).setNumberFormat('@'));
  col('Message').setWrap(true);
  col('Notes').setWrap(true);
  col('Status').setFontWeight('bold').setHorizontalAlignment('center');
  col('Owner').setHorizontalAlignment('center');
  col('Replied').setHorizontalAlignment('center').setFontColor(ACCENT);
  col('Next step').setNumberFormat('ddd mmm d').setHorizontalAlignment('center');
  col('Enquiry #').setFontColor(MUTED).setHorizontalAlignment('center');

  // Dropdowns, date picker and checkbox. requireCheckbox leaves any ticks as
  // they are, where insertCheckboxes would clear them.
  col('Status').setDataValidation(SpreadsheetApp.newDataValidation()
    .requireValueInRange(lists.getRange('A2:A'), true).setAllowInvalid(false).build());
  col('Owner').setDataValidation(SpreadsheetApp.newDataValidation()
    .requireValueInRange(lists.getRange('B2:B'), true).setAllowInvalid(false).build());
  col('Next step').setDataValidation(SpreadsheetApp.newDataValidation()
    .requireDate().setAllowInvalid(false).setHelpText('Pick a date: double-click for the calendar.').build());
  col('Replied').setDataValidation(SpreadsheetApp.newDataValidation().requireCheckbox().build());

  // Alternate rows in white and the website's paper tone. From the title row
  // down, so a lead added just under the titles is inside it and picks it up.
  leads.getBandings().forEach((b) => b.remove());
  leads.getRange(1, 1, last, width).applyRowBanding(SpreadsheetApp.BandingTheme.LIGHT_GREY, true, false)
    .setHeaderRowColor(INK).setFirstRowColor('#FFFFFF').setSecondRowColor(ELEV);
  leads.setHiddenGridlines(true);

  // Colours that mean something. Every rule also starts at the title row, for
  // the same reason; none of them can match a title.
  const whole = (name) => leads.getRange(1, COL[name], last, 1);
  const rules = statusRules_(whole('Status'));
  const closed = CLOSED.map((s) => `$B1="${s}"`).join(',');
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied(`=AND(ISNUMBER($D1), $D1<=TODAY(), NOT(OR(${closed})))`)
    .setFontColor(URGENT).setBold(true).setBackground(URGENT_BG).setRanges([whole('Next step')]).build());
  rules.push(SpreadsheetApp.newConditionalFormatRule()
    .whenFormulaSatisfied('=AND($B1="New", $E1<>TRUE, ISNUMBER($A1), NOW()-$A1>1)')
    .setBackground(URGENT_BG).setRanges([leads.getRange(1, 1, last, width)]).build());
  leads.setConditionalFormatRules(rules);

  // A nudge, not a lock, on the titles: the website writes by position.
  leads.getProtections(SpreadsheetApp.ProtectionType.RANGE)
    .filter((p) => p.getDescription() === 'Column titles').forEach((p) => p.remove());
  head.protect().setDescription('Column titles').setWarningOnly(true);

  if (!leads.getFilter()) leads.getRange(1, 1, last, width).createFilter();
  leads.setTabColor(colour);
}

/** The status chip colours, for any range of statuses. */
function statusRules_(range) {
  return STATUS.map((s) => SpreadsheetApp.newConditionalFormatRule()
    .whenTextEqualTo(s[0]).setBackground(s[1]).setFontColor(s[2]).setBold(true).setRanges([range]).build());
}

/* ---- Overview: every tab added up, under the logo ------------------------- */

/** A tab name as a formula reference. */
function ref_(name) {
  return "'" + String(name).replace(/'/g, "''") + "'";
}
/** One formula summing the same count over every lead tab. */
function across_(tabs, count) {
  return '=' + tabs.map((t) => count(ref_(t))).join('+');
}
const newLast7_ = (t) => `COUNTIF(${t}!A:A,">="&(NOW()-7))`;
const waiting_ = (t) => `COUNTIFS(${t}!B:B,"New",${t}!E:E,FALSE)`;
const due_ = (t) => `COUNTIFS(${t}!D:D,"<="&TODAY(),${CLOSED.map((s) => `${t}!B:B,"<>${s}"`).join(',')})`;
const tours_ = (t) => `COUNTIF(${t}!B:B,"Tour booked")`;
const all_ = (t) => `COUNTA(${t}!P2:P)`;

function buildOverview_(sheet) {
  const ss = sheet.getParent();
  const tabs = leadTabs_().filter((n) => ss.getSheetByName(n));
  sheet.clear();
  sheet.getImages().forEach((img) => img.remove());
  sheet.setConditionalFormatRules([]);
  const height = 34 + tabs.length + STATUS.length + SOURCES.length;
  if (sheet.getMaxRows() < height) sheet.insertRowsAfter(sheet.getMaxRows(), height - sheet.getMaxRows());
  if (sheet.getMaxColumns() < 9) sheet.insertColumnsAfter(sheet.getMaxColumns(), 9 - sheet.getMaxColumns());
  sheet.getRange(1, 1, sheet.getMaxRows(), sheet.getMaxColumns()).breakApart();
  sheet.setHiddenGridlines(true);

  // A four-column grid: B, D, F, H hold content; A, C, E, G, I are gutters.
  [28, 210, 22, 210, 22, 210, 22, 210, 28].forEach((w, i) => sheet.setColumnWidth(i + 1, w));
  sheet.getRange(1, 1, sheet.getMaxRows(), 9).setBackground(PAGE).setFontFamily(SANS).setFontSize(10)
    .setFontColor(INK).setVerticalAlignment('middle');

  // The banner: ink, with the Evolution24 logo.
  sheet.getRange('B2:H5').setBackground(INK);
  [[1, 20], [2, 18], [3, 44], [4, 30], [5, 18]].forEach(([r, h]) => sheet.setRowHeight(r, h));
  if (LOGO_PNG) sheet.insertImage(image_(LOGO_PNG, 'evolution24.png'), 2, 3, 22, 2).setWidth(250).setHeight(61);
  sheet.getRange('F3:H4').merge();
  sheet.getRange('F3').setValue('LEAD SHEET').setFontSize(9).setFontWeight('bold').setFontColor(TAN)
    .setHorizontalAlignment('right').setVerticalAlignment('middle');

  // Four numbers, across every property.
  sheet.setRowHeight(6, 20);
  const tiles = [
    ['NEW · LAST 7 DAYS', across_(tabs, newLast7_), 'enquiries received'],
    ['WAITING FOR A REPLY', across_(tabs, waiting_), 'New, and Replied not ticked'],
    ['FOLLOW-UPS DUE', across_(tabs, due_), 'Next step is today or past'],
    ['TOURS BOOKED', across_(tabs, tours_), 'status Tour booked'],
  ];
  [[7, 30], [8, 50], [9, 28]].forEach(([r, h]) => sheet.setRowHeight(r, h));
  tiles.forEach(([label, formula, caption], i) => {
    const c = 2 + i * 2;
    sheet.getRange(7, c, 3, 1).setBackground('#FFFFFF')
      .setBorder(true, true, true, true, false, false, LINE, SpreadsheetApp.BorderStyle.SOLID);
    sheet.getRange(7, c).setValue(label).setFontSize(8).setFontWeight('bold').setFontColor(MUTED)
      .setVerticalAlignment('bottom');
    sheet.getRange(8, c).setFormula(formula).setFontFamily(SERIF).setFontSize(30).setHorizontalAlignment('left');
    sheet.getRange(9, c).setValue(caption).setFontSize(9).setFontColor(MUTED).setVerticalAlignment('top');
  });
  const rules = ['D8', 'F8'].map((a1) => SpreadsheetApp.newConditionalFormatRule()
    .whenNumberGreaterThan(0).setFontColor(URGENT).setRanges([sheet.getRange(a1)]).build());

  // By property: each tab, a link to it, and what is waiting on it.
  sheet.setRowHeight(10, 26);
  const byHead = 11;
  sheet.getRange(byHead, 2, 1, 7).setValues([['BY PROPERTY', '', 'WAITING FOR A REPLY', '', 'FOLLOW-UPS DUE', '', 'ALL ENQUIRIES']])
    .setFontSize(8).setFontWeight('bold').setFontColor(MUTED);
  sheet.getRange(byHead, 4, 1, 5).setHorizontalAlignment('right');
  tabs.forEach((name, i) => {
    const r = byHead + 1 + i;
    const t = ref_(name);
    const gid = ss.getSheetByName(name).getSheetId();
    sheet.setRowHeight(r, 30);
    sheet.getRange(r, 2, 1, 7).setBorder(false, false, true, false, false, false, LINE, SpreadsheetApp.BorderStyle.SOLID);
    sheet.getRange(r, 2).setFormula(`=HYPERLINK("#gid=${gid}","${String(name).replace(/"/g, '""')}")`)
      .setFontWeight('bold').setFontColor(name === GENERAL ? SUBTLE : INK);
    sheet.getRange(r, 4).setFormula('=' + waiting_(t)).setFontFamily(SERIF).setFontSize(16).setHorizontalAlignment('right');
    sheet.getRange(r, 6).setFormula('=' + due_(t)).setFontFamily(SERIF).setFontSize(16).setHorizontalAlignment('right');
    sheet.getRange(r, 8).setFormula('=' + all_(t)).setFontFamily(SERIF).setFontSize(16).setHorizontalAlignment('right');
  });
  const byEnd = byHead + tabs.length;
  rules.push(SpreadsheetApp.newConditionalFormatRule().whenNumberGreaterThan(0).setFontColor(URGENT)
    .setRanges([sheet.getRange(byHead + 1, 4, tabs.length, 1), sheet.getRange(byHead + 1, 6, tabs.length, 1)]).build());

  // By status, across every property, each with a bar.
  const top = byEnd + 3;
  sheet.setRowHeight(top - 2, 26);
  sheet.getRange(top - 1, 2).setValue('BY STATUS').setFontSize(8).setFontWeight('bold').setFontColor(MUTED);
  sheet.getRange(top - 1, 8).setFormula(across_(tabs, all_) + '&" enquiries in all"').setFontSize(9)
    .setFontColor(MUTED).setHorizontalAlignment('right');
  const n = 10;
  for (let i = 0; i < n; i++) {
    const r = top + i;
    sheet.setRowHeight(r, 30);
    sheet.getRange(r, 2).setFormula(`=IF(Lists!A${i + 2}="","",Lists!A${i + 2})`)
      .setHorizontalAlignment('center').setFontWeight('bold');
    sheet.getRange(r, 4, 1, 3).merge();
    sheet.getRange(r, 4).setFormula(
      `=IF(B${r}="","",SPARKLINE(H${r},{"charttype","bar";"max",MAX(1,MAX($H$${top}:$H$${top + n - 1}));"color1","${ACCENT}"}))`);
    sheet.getRange(r, 8).setFormula(`=IF(B${r}="","",${tabs.map((name) => `COUNTIF(${ref_(name)}!B:B,B${r})`).join('+')})`)
      .setFontFamily(SERIF).setFontSize(16).setHorizontalAlignment('right');
  }
  statusRules_(sheet.getRange(top, 2, n, 1)).forEach((rule) => rules.push(rule));

  // Where they heard about us, across every property.
  const head = top + n + 1;
  sheet.setRowHeight(head - 1, 26);
  sheet.getRange(head, 2).setValue('WHERE THEY HEARD ABOUT US').setFontSize(8).setFontWeight('bold').setFontColor(MUTED);
  const labels = SOURCES.concat(['Not given']);
  labels.forEach((label, i) => {
    const r = head + 1 + i;
    sheet.setRowHeight(r, 30);
    sheet.getRange(r, 2).setValue(label).setFontColor(SUBTLE);
    sheet.getRange(r, 8).setFormula(label === 'Not given'
      ? across_(tabs, (t) => `COUNTIFS(${t}!P2:P,"<>",${t}!L2:L,"")`)
      : across_(tabs, (t) => `COUNTIF(${t}!L:L,"${label.replace(/"/g, '""')}")`))
      .setFontFamily(SERIF).setFontSize(16).setHorizontalAlignment('right');
    sheet.getRange(r, 4, 1, 3).merge();
    sheet.getRange(r, 4).setFormula(
      `=SPARKLINE(H${r},{"charttype","bar";"max",MAX(1,MAX($H$${head + 1}:$H$${head + labels.length}));"color1","#3F6F47"})`);
  });

  const foot = head + labels.length + 2;
  sheet.getRange(foot, 2, 1, 7).merge();
  sheet.getRange(foot, 2)
    .setValue('Updates by itself as enquiries arrive from evolution24.net. Charlotte Square has its own lead sheet. Change the dropdown choices on the Lists tab.')
    .setFontSize(9).setFontColor(MUTED).setFontStyle('italic');
  sheet.setConditionalFormatRules(rules);
  sheet.setTabColor(INK);
}

function image_(b64, name) {
  return Utilities.newBlob(Utilities.base64Decode(b64), 'image/png', name);
}

/** Menu in the sheet itself. */
function onOpen() {
  SpreadsheetApp.getUi().createMenu('Evolution24')
    .addItem('Show the connection token', 'showToken')
    .addItem('Set up and restyle the sheet', 'setup')
    .addToUi();
}

/** The shared secret, made once and kept in this script's properties. */
function tokenFor_() {
  const props = PropertiesService.getScriptProperties();
  let token = props.getProperty('TOKEN');
  if (!token) {
    token = Utilities.getUuid().replace(/-/g, '') + Utilities.getUuid().replace(/-/g, '');
    props.setProperty('TOKEN', token);
  }
  return token;
}

function showToken() {
  const ui = SpreadsheetApp.getUi();
  ui.alert('Connection token', 'Paste this into Vercel as LEADS_SHEET_TOKEN:\n\n' + tokenFor_(), ui.ButtonSet.OK);
}

/** Opening the web-app address in a browser just says it is there. */
function doGet() {
  return ContentService.createTextOutput('The Evolution24 lead sheet is connected. The website sends new enquiries here.');
}

/** A sheet name from what the website sent: no characters Sheets refuses. */
function tabName_(v) {
  return String(v == null ? '' : v).replace(/[\[\]*?:\/\\]/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 80);
}

/** One enquiry from the website: {token, lead}. Answers {ok, tab} or {ok:false, error}. */
function doPost(e) {
  const answer = (obj) => ContentService.createTextOutput(JSON.stringify(obj)).setMimeType(ContentService.MimeType.JSON);
  let body;
  try {
    body = JSON.parse(e.postData.contents);
  } catch (err) {
    return answer({ ok: false, error: 'Not JSON.' });
  }
  const token = PropertiesService.getScriptProperties().getProperty('TOKEN');
  if (!token || !body || body.token !== token) return answer({ ok: false, error: 'Wrong token.' });

  const lead = body.lead || {};
  const lock = LockService.getScriptLock();
  lock.waitLock(20000);
  try {
    const ss = SpreadsheetApp.getActive();
    const lists = ss.getSheetByName(LISTS);
    if (!lists || !ss.getSheetByName(GENERAL)) return answer({ ok: false, error: 'Run setup first.' });

    // The property's tab, or General. A property this code does not know yet
    // gets a tab of its own, styled like the rest, and joins the Overview.
    const name = tabName_(lead.property) || GENERAL;
    let sheet = ss.getSheetByName(name);
    if (!sheet || name === OVERVIEW || name === LISTS) {
      if (name === OVERVIEW || name === LISTS) return answer({ ok: false, error: 'That tab name is reserved.' });
      sheet = ss.insertSheet(name, ss.getSheets().length - 1);
      buildLeads_(sheet, lists, ACCENT);
      const props = PropertiesService.getScriptProperties();
      const extra = JSON.parse(props.getProperty('EXTRA_TABS') || '[]');
      if (extra.indexOf(name) < 0) props.setProperty('EXTRA_TABS', JSON.stringify(extra.concat([name])));
      const overview = ss.getSheetByName(OVERVIEW);
      if (overview) buildOverview_(overview);
    }

    // The website may send the same enquiry twice (a retry): keep one row.
    const id = String(lead.id || '');
    if (id && sheet.getLastRow() > 1) {
      const ids = sheet.getRange(2, COL['Enquiry #'], sheet.getLastRow() - 1, 1);
      if (ids.createTextFinder(id).matchEntireCell(true).findNext()) return answer({ ok: true, duplicate: true, tab: name });
    }

    // Newest at the top, with the dropdowns, checkbox and look of the row below.
    sheet.insertRowBefore(2);
    const row = sheet.getRange(2, 1, 1, HEADERS.length);
    const below = sheet.getRange(3, 1, 1, HEADERS.length);
    below.copyTo(row, SpreadsheetApp.CopyPasteType.PASTE_FORMAT, false);
    below.copyTo(row, SpreadsheetApp.CopyPasteType.PASTE_DATA_VALIDATION, false);
    sheet.setRowHeightsForced(2, 1, ROW_H);

    const received = new Date(lead.received);
    const values = {
      'Received': isNaN(received) ? new Date() : received,
      'Status': 'New',
      'Owner': '',
      'Next step': '',
      'Replied': false,
      'Name': text_(lead.name),
      'Email': text_(lead.email),
      'Phone': text_(lead.phone),
      'Interested in': text_(lead.interest),
      'Bedrooms': text_(lead.bedrooms),
      'Moving in': text_(lead.move_in),
      'Heard about us': text_(lead.source),
      'Came via': text_(lead.came_via),
      'Message': text_(lead.message),
      'Notes': '',
      'Enquiry #': text_(id),
    };
    row.setValues([HEADERS.map((h) => values[h])]);

    // The address as a link that starts an email to them. A link, not a
    // formula, so nothing they typed can run.
    const email = String(lead.email || '');
    if (/^[^\s@"'<>]+@[^\s@"'<>]+\.[^\s@"'<>]+$/.test(email)) {
      sheet.getRange(2, COL['Email']).setRichTextValue(SpreadsheetApp.newRichTextValue()
        .setText(email).setLinkUrl('mailto:' + email)
        .setTextStyle(SpreadsheetApp.newTextStyle().setForegroundColor(ACCENT).setUnderline(false).build())
        .build());
    }
    return answer({ ok: true, tab: name });
  } finally {
    lock.releaseLock();
  }
}

/** Whatever a visitor typed, as plain text. A leading = + - or @ would make
 *  Sheets treat it as a formula, which a stranger could use to fetch data or
 *  plant a link; a leading apostrophe keeps it text and does not show. */
function text_(v) {
  const s = v == null ? '' : String(v).slice(0, 5000);
  return /^[=+\-@\t\r]/.test(s) ? "'" + s : s;
}

